+  // meshcomod: the companion's own Wi-Fi manager owns the radio; this link only reports.
+  return externalNetworkLink();
+#else
 #if defined(NETWORK_PREFER_ETHERNET)
   static AutomaticNetworkLink network;
 #else
   static WiFiNetworkLink network;
 #endif
   return network;
+#endif
+}
+
+#if defined(NETWORK_LINK_EXTERNAL_WIFI)
+NetworkLink& externalNetworkLink() {
+  static ExternalWiFiNetworkLink network;
+  return network;
 }
 #endif
+#endif
