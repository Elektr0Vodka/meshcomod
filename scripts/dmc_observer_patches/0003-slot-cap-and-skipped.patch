diff --git a/src/helpers/bridges/MQTTBridge.cpp b/src/helpers/bridges/MQTTBridge.cpp
index b2af6d9d..e5b9e077 100644
--- a/src/helpers/bridges/MQTTBridge.cpp
+++ b/src/helpers/bridges/MQTTBridge.cpp
@@ -523,16 +523,23 @@ bool MQTTBridge::getSlotCounts(int* connected, int* enabled) {
 #define MQTT_MAX_ACTIVE_SLOTS_NO_PSRAM 2
 #endif
 
+// meshcomod: run-time cap set by the host before begin(); 0 means no extra cap.
+static int s_active_slot_cap = 0;
+
+void MQTTBridge::setActiveSlotCap(int cap) { s_active_slot_cap = cap < 0 ? 0 : cap; }
+
 int MQTTBridge::getMaxActiveSlots() {
   // Each WSS/TLS connection needs ~40KB for mbedTLS buffers. Without PSRAM even
   // 3 concurrent connections would exhaust internal heap, so cap at 2 (less on
   // builds that spend internal RAM elsewhere); with PSRAM cap at 5 (6
   // configurable but 5 active max).
 #if defined(ESP_PLATFORM) && defined(BOARD_HAS_PSRAM)
-  return psramFound() ? 5 : MQTT_MAX_ACTIVE_SLOTS_NO_PSRAM;
+  int max_slots = psramFound() ? 5 : MQTT_MAX_ACTIVE_SLOTS_NO_PSRAM;
 #else
-  return MQTT_MAX_ACTIVE_SLOTS_NO_PSRAM;
+  int max_slots = MQTT_MAX_ACTIVE_SLOTS_NO_PSRAM;
 #endif
+  if (s_active_slot_cap > 0 && s_active_slot_cap < max_slots) max_slots = s_active_slot_cap;
+  return max_slots;
 }
 
 bool MQTTBridge::stopUnprovenLatched() { return s_stop_unproven; }
